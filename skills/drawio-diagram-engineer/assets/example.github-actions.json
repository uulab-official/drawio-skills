{
  "name": "Release",
  "on": ["push"],
  "jobs": {
    "lint": {"name": "Lint", "runs-on": "ubuntu-latest"},
    "test": {"name": "Test", "runs-on": "ubuntu-latest", "needs": "lint"},
    "build": {"name": "Build image", "runs-on": "ubuntu-latest", "needs": "test"},
    "deploy": {"name": "Deploy production", "runs-on": "ubuntu-latest", "needs": "build"}
  }
}
