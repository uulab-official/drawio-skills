{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/ha-v1.json",
  "title": "High Availability Architecture Model",
  "type": "object",
  "required": ["version", "ha", "domains", "components", "links", "failovers"],
  "properties": {
    "version": {"const": "1"},
    "ha": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "direction": {"enum": ["LR", "TB"]},
        "theme": {"enum": ["light", "dark", "colorblind"]},
        "availability": {"type": "string"},
        "rto": {"type": "string"},
        "rpo": {"type": "string"},
        "gap": {"type": "integer", "minimum": 40, "maximum": 400}
      },
      "additionalProperties": true
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/domain"}
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "links": {
      "type": "array",
      "items": {"$ref": "#/$defs/link"}
    },
    "failovers": {
      "type": "array",
      "items": {"$ref": "#/$defs/failover"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "level": {"enum": ["region", "zone", "rack", "node"]},
        "region": {"type": "string"},
        "failure_domain": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["id", "label", "domain", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "domain": {"$ref": "#/$defs/id"},
        "role": {
          "enum": [
            "active",
            "standby",
            "active-active",
            "replica",
            "quorum",
            "load-balancer",
            "witness",
            "client"
          ]
        },
        "kind": {
          "enum": [
            "client",
            "service",
            "database",
            "queue",
            "external",
            "process",
            "document",
            "note"
          ]
        },
        "replicas": {"type": "integer", "minimum": 1},
        "stateful": {"type": "boolean"},
        "technology": {"type": "string"},
        "health_check": {"type": "string"},
        "position": {"$ref": "#/$defs/position"}
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": ["id", "from", "to", "mode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "mode": {
          "enum": [
            "traffic",
            "sync-replication",
            "async-replication",
            "heartbeat",
            "quorum"
          ]
        },
        "label": {"type": "string"}
      },
      "additionalProperties": true
    },
    "failover": {
      "type": "object",
      "required": ["id", "from", "to", "trigger"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "trigger": {"type": "string", "minLength": 1},
        "automatic": {"type": "boolean"},
        "replication": {"type": "string"},
        "rto": {"type": "string"},
        "rpo": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
