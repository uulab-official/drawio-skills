{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {"name": "checkout", "namespace": "commerce"},
      "spec": {
        "rules": [
          {
            "http": {
              "paths": [
                {
                  "path": "/checkout",
                  "backend": {
                    "service": {"name": "checkout-api", "port": {"number": 80}}
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {"name": "checkout-api", "namespace": "commerce"},
      "spec": {"selector": {"app": "checkout-api"}, "type": "ClusterIP"}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {"name": "checkout-api", "namespace": "commerce"},
      "spec": {
        "replicas": 3,
        "template": {
          "metadata": {"labels": {"app": "checkout-api"}},
          "spec": {
            "containers": [
              {
                "name": "api",
                "envFrom": [
                  {"configMapRef": {"name": "checkout-config"}},
                  {"secretRef": {"name": "checkout-secrets"}}
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {"name": "checkout-config", "namespace": "commerce"}
    },
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {"name": "checkout-secrets", "namespace": "commerce"},
      "data": {"database-password": "never-exported"}
    }
  ]
}
