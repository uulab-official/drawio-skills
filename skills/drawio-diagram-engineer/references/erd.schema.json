{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/erd-v1.json",
  "title": "Entity Relationship Diagram Model",
  "type": "object",
  "required": ["version", "erd", "entities", "relationships"],
  "properties": {
    "version": {"const": "1"},
    "erd": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "direction": {"enum": ["LR", "TB"]},
        "theme": {"enum": ["light", "dark", "colorblind"]},
        "gap": {"type": "integer", "minimum": 40, "maximum": 400}
      },
      "additionalProperties": true
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "cardinality": {
      "enum": ["one", "zero-or-one", "one-or-many", "zero-or-many"]
    },
    "field": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "nullable": {"type": "boolean"},
        "primary_key": {"type": "boolean"},
        "foreign_key": {"type": "boolean"},
        "unique": {"type": "boolean"},
        "default": {}
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": ["id", "label", "fields"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "schema": {"type": "string"},
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"}
          },
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/field"}
        }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["id", "from", "to", "from_cardinality", "to_cardinality"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "from_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "to_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "from_cardinality": {"$ref": "#/$defs/cardinality"},
        "to_cardinality": {"$ref": "#/$defs/cardinality"},
        "identifying": {"type": "boolean"},
        "label": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
