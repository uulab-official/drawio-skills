{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/review-ownership-v1.json",
  "title": "Draw.io Review Ownership v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "routes"],
  "properties": {
    "format": {
      "const": "drawio-review-ownership/v1"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owners"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "owners": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pages": {
            "$ref": "#/$defs/semanticPatterns"
          },
          "cells": {
            "$ref": "#/$defs/semanticPatterns"
          },
          "rules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.*?/-]+$"
            }
          }
        },
        "anyOf": [
          {
            "required": ["pages"]
          },
          {
            "required": ["cells"]
          },
          {
            "required": ["rules"]
          }
        ]
      }
    }
  },
  "$defs": {
    "semanticPatterns": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9*?]+(?:-[a-z0-9*?]+)*$"
      }
    }
  }
}
