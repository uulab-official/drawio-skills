      "group": "edge",
      "position": {"x": 410, "y": 320}
    },
    {
      "id": "monitor",
      "label": "Health Monitor",
      "kind": "external",
      "position": {"x": 410, "y": 80}
    },
    {
      "id": "orders",
      "label": "Orders",
      "kind": "service",
      "group": "services",
      "position": {"x": 790, "y": 130}
    },
    {
      "id": "payments",
      "label": "Payments",
      "kind": "service",
      "group": "services",
      "position": {"x": 790, "y": 320}
    },
    {
      "id": "profile",
      "label": "Profile",
      "kind": "service",
      "group": "services",
      "position": {"x": 790, "y": 510}
    },
    {
      "id": "orders-db",
      "label": "Orders DB",
