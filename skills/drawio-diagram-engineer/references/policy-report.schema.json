{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/architecture-policy-report-v1.json",
  "title": "Draw.io Architecture Policy Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "evaluation_date",
    "policy",
    "policies",
    "passed",
    "errors",
    "warnings",
    "results",
    "exceptions"
  ],
  "properties": {
    "format": {
      "const": "drawio-architecture-policy-report/v1"
    },
    "status": {
      "enum": ["not-configured", "passed", "failed"]
    },
    "evaluation_date": {
      "type": "string",
      "format": "date"
    },
    "policy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/policySummary"
        }
      ]
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policySummary"
      }
    },
    "passed": {
      "type": "boolean"
    },
    "errors": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleResult"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exceptionResult"
      }
    }
  },
  "$defs": {
    "policySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "id", "name", "source"],
      "properties": {
        "format": {
          "const": "drawio-architecture-policy/v1"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "id",
        "key",
        "type",
        "level",
        "passed",
        "compliant",
        "waived",
        "exceptions",
        "message",
        "detail"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "level": {
          "enum": ["error", "warning"]
        },
        "passed": {
          "type": "boolean"
        },
        "compliant": {
          "type": "boolean"
        },
        "waived": {
          "type": "boolean"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "exceptionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "id",
        "key",
        "rule",
        "level",
        "reason",
        "owner",
        "expires",
        "scope",
        "status",
        "applied_to"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "level": {
          "enum": ["error", "warning"]
        },
        "reason": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "expires": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "object"
        },
        "status": {
          "enum": ["applied", "unused", "expired"]
        },
        "applied_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
