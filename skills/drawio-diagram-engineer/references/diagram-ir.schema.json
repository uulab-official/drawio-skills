{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/diagram-ir-v1.json",
  "title": "Draw.io Diagram IR",
  "type": "object",
  "required": ["version", "diagram"],
  "properties": {
    "version": {"const": "1"},
    "diagram": {"$ref": "#/$defs/diagram"},
    "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "oneOf": [
    {
      "required": ["nodes", "edges"],
      "not": {"required": ["pages"]}
    },
    {
      "required": ["pages"],
      "not": {
        "anyOf": [
          {"required": ["nodes"]},
          {"required": ["edges"]},
          {"required": ["groups"]}
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "diagram": {
      "type": "object",
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "direction": {"enum": ["LR", "TB"]},
        "theme": {"enum": ["light", "dark", "colorblind"]},
        "theme_tokens": {"$ref": "#/$defs/themeTokens"},
        "gap": {"type": "integer", "minimum": 40, "maximum": 400},
        "background": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
      },
      "additionalProperties": true
    },
    "group": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "client",
            "service",
            "database",
            "queue",
            "external",
            "decision",
            "process",
            "document",
            "note",
            "entity"
          ]
        },
        "group": {"$ref": "#/$defs/id"},
        "description": {"type": "string"},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/entityField"}
        },
        "link": {"$ref": "#/$defs/id"},
        "position": {"$ref": "#/$defs/position"},
        "size": {"$ref": "#/$defs/size"},
        "style": {"$ref": "#/$defs/nodeStyle"}
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "label": {"type": "string"},
        "kind": {"enum": ["sync", "async", "data", "dependency", "association"]},
        "style": {"$ref": "#/$defs/edgeStyle"}
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["id", "title", "nodes", "edges"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "diagram": {"$ref": "#/$defs/diagram"},
        "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      },
      "additionalProperties": true
    },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "nodeStyle": {
      "type": "object",
      "properties": {
        "fill": {"type": "string"},
        "stroke": {"type": "string"},
        "font": {"type": "string"},
        "dashed": {"type": "boolean"},
        "rounded": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "edgeStyle": {
      "type": "object",
      "properties": {
        "color": {"type": "string"},
        "dashed": {"type": "boolean"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "start_cardinality": {
          "enum": ["one", "zero-or-one", "one-or-many", "zero-or-many"]
        },
        "end_cardinality": {
          "enum": ["one", "zero-or-one", "one-or-many", "zero-or-many"]
        }
      },
      "additionalProperties": false
    },
    "themeTokens": {
      "type": "object",
      "required": [
        "background",
        "group_fill",
        "group_stroke",
        "font",
        "edge",
        "client",
        "service",
        "database",
        "queue",
        "external",
        "decision",
        "process",
        "document",
        "note",
        "entity"
      ],
      "properties": {
        "background": {"$ref": "#/$defs/color"},
        "group_fill": {"$ref": "#/$defs/color"},
        "group_stroke": {"$ref": "#/$defs/color"},
        "font": {"$ref": "#/$defs/color"},
        "edge": {"$ref": "#/$defs/color"},
        "client": {"$ref": "#/$defs/colorPair"},
        "service": {"$ref": "#/$defs/colorPair"},
        "database": {"$ref": "#/$defs/colorPair"},
        "queue": {"$ref": "#/$defs/colorPair"},
        "external": {"$ref": "#/$defs/colorPair"},
        "decision": {"$ref": "#/$defs/colorPair"},
        "process": {"$ref": "#/$defs/colorPair"},
        "document": {"$ref": "#/$defs/colorPair"},
        "note": {"$ref": "#/$defs/colorPair"},
        "entity": {"$ref": "#/$defs/colorPair"}
      },
      "additionalProperties": false
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "colorPair": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/color"},
        {"$ref": "#/$defs/color"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "entityField": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "nullable": {"type": "boolean"},
        "primary_key": {"type": "boolean"},
        "foreign_key": {"type": "boolean"},
        "unique": {"type": "boolean"},
        "default": {}
      },
      "additionalProperties": true
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
