{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/adr-adapter.schema.json",
  "title": "Architecture decision record adapter output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "decisions"],
      "properties": {
        "format": {"const": "drawio-adr-adapter/v1"},
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/decision"}
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "tool_version", "source_sha256", "decisions"],
      "properties": {
        "format": {"const": "drawio-adr-adapter/v1"},
        "tool_version": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "sha256"],
            "properties": {
              "id": {"type": "string"},
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "decision", "affects", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "accepted", "deprecated", "superseded"]},
        "decision": {"type": "string", "minLength": 1},
        "affects": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
