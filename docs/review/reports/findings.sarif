          },
          "properties": {
            "source": "policy",
            "policyId": "production",
            "detail": "visual baseline is not configured",
            "owners": [
              "@uulab/architecture"
            ],
            "ownerSource": "routes",
            "ownerRouteIds": [
              "architecture-policy"
            ]
          }
        },
        {
          "ruleId": "review.annotation-open",
          "level": "warning",
          "message": {
            "text": "Confirm the long-term owning team for the order event stream."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
