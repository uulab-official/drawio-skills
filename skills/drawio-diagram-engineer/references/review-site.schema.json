{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/review-site-v1.json",
  "title": "Draw.io Review Site Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "generator",
    "tool_version",
    "title",
    "source_bundle",
    "pages",
    "catalog",
    "annotations",
    "status",
    "artifacts"
  ],
  "properties": {
    "format": {
      "const": "drawio-review-site/v1"
    },
    "generator": {
      "const": "drawio-diagram-engineer"
    },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_bundle": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "revision_type",
        "bundle_sha256",
        "artifacts"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "revision_type": {
          "enum": ["scm", "bundle"]
        },
        "repository": {
          "type": ["string", "null"]
        },
        "source_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "artifact",
          "sha256",
          "nodes",
          "edges",
          "groups"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "pattern": "^pages/[a-z0-9-]+\\.svg$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "nodes": {
            "type": "integer",
            "minimum": 0
          },
          "edges": {
            "type": "integer",
            "minimum": 0
          },
          "groups": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "catalog": {
      "type": "array"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "page", "cell", "status", "message", "href"],
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "cell": {
            "type": "string"
          },
          "status": {
            "enum": ["open", "accepted", "resolved"]
          },
          "message": {
            "type": "string"
          },
          "href": {
            "type": "string",
            "pattern": "^pages/[a-z0-9-]+\\.svg#[a-z0-9-]+$"
          },
          "source": {
            "type": "string"
          },
          "lifecycle": {
            "enum": ["added", "carried", "updated"]
          }
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "audit",
        "security",
        "extraction",
        "exports",
        "visual_regression"
      ],
      "properties": {
        "audit": {
          "type": "object"
        },
        "security": {
          "type": "object"
        },
        "extraction": {
          "type": "object"
        },
        "exports": {
          "type": "object"
        },
        "visual_regression": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "policy": {
          "type": "object"
        },
        "ownership": {
          "type": "object"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["index", "manifest", "audit", "security", "extraction"],
      "properties": {
        "index": {
          "const": "index.html"
        },
        "manifest": {
          "const": "review.json"
        },
        "audit": {
          "const": "reports/audit.json"
        },
        "security": {
          "const": "reports/security.json"
        },
        "extraction": {
          "const": "reports/extraction.json"
        },
        "policy": {
          "const": "reports/policy.json"
        },
        "sarif": {
          "const": "reports/findings.sarif"
        },
        "ownership": {
          "const": "reports/ownership.json"
        },
        "summary": {
          "const": "reports/summary.md"
        }
      }
    },
    "policy": {
      "type": "object"
    },
    "ownership": {
      "type": "object"
    }
  }
}
