{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "drawio-diagram-engineer",
          "version": "1.7.0",
          "informationUri": "https://github.com/uulab-official/drawio-skills",
          "rules": [
            {
              "id": "policy.production.approved-baseline",
              "name": "policy_production_approved_baseline",
              "shortDescription": {
                "text": "Policy Production Approved Baseline"
              }
            },
            {
              "id": "review.annotation-open",
              "name": "review_annotation_open",
              "shortDescription": {
                "text": "Review Annotation Open"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "policy.production.approved-baseline",
          "level": "warning",
          "message": {
            "text": "visual baseline is not configured"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "reports/policy.json"
                }
              },
              "logicalLocations": [
                {
                  "name": "production/approved-baseline",
                  "fullyQualifiedName": "production/approved-baseline"
                }
