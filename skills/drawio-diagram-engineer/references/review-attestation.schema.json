{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/review-attestation-v1.json",
  "title": "Draw.io Review Attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {
            "const": "review.json"
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://github.com/uulab-official/drawio-skills/attestations/review/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "tool_version", "source", "bundle"],
      "properties": {
        "generator": {
          "const": "drawio-diagram-engineer"
        },
        "tool_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "revision_type",
            "repository",
            "path",
            "url"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "revision_type": {
              "enum": ["scm", "bundle"]
            },
            "repository": {
              "type": ["string", "null"]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": ["string", "null"],
              "format": "uri"
            }
          }
        },
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "artifacts"],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "artifacts": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
