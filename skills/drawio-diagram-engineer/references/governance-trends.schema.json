{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/governance-trends.schema.json",
  "title": "Architecture governance trend export",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "subject", "snapshots", "change"],
  "properties": {
    "format": {"const": "drawio-governance-trends/v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_path"],
      "properties": {
        "repository": {"type": ["string", "null"]},
        "source_path": {"type": "string", "minLength": 1}
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "review_sha256", "revision", "metrics"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "revision": {"type": "string", "minLength": 1},
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "integer"}
          }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    }
  }
}
