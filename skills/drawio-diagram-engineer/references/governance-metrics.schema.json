{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uulab-official/drawio-skills/schemas/governance-metrics.schema.json",
  "title": "Governance metrics export report",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "source_sha256", "snapshots", "artifacts"],
  "properties": {
    "format": {"const": "drawio-governance-metrics/v1"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "snapshots": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "prometheus": {"$ref": "#/$defs/artifact"},
        "otlp": {"$ref": "#/$defs/artifact"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
